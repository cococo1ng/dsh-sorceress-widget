{
  "name": "dsh-sorceress-widget",
  "version": "0.59.0",
  "description": "A witch in the corner of DSH: 7 position-aware tarot spreads (multi-card spreads require a question) with rich readings, a daily horoscope from real moon phase and three retrogrades, a mood diary with wish jar and breathing break, 13 auto-rotating standing poses, an encrypted archive for bazi, cycle and compatibility, plus a usage-bill panel. All assets inlined, no external process. / DSH 角上的塔罗女巫：7 种牌阵（多张牌阵必写「所问」）带位置含义与富解读、今日星座（真月相 + 水金火逆行 + 可存图）、心情与许愿瓶与缓一缓、13 张站姿自动轮转、加密档案（四柱 / 周期 / 婚配）、计费账单与月相提醒。素材全内联，不依赖外部进程。",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.png",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "srs-engine.mjs",
    "srs-tools.mjs",
    "client.js",
    "cordis.patch.yml",
    "assets",
    "data",
    "icon.png",
    "icon-128.png",
    "icon-256.png",
    "README.md",
    "CHANGELOG.md",
    "NOTICE.md",
    "LICENSE",
    "LICENSE-ASSETS",
    "docs",
    "screenshots.json",
    "locale"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "widget",
    "tarot",
    "horoscope",
    "moon-phase",
    "journal",
    "bazi",
    "bill"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "license": "MIT",
  "dsh": {
    "name": "Sorceress · 塔罗挂件",
    "category": "ui",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    },
    "displayName": "Sorceress · 塔罗挂件"
  },
  "displayName": "Sorceress · 塔罗挂件",
  "author": "YG",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cococo1ng/dsh-sorceress-widget.git"
  },
  "homepage": "https://github.com/cococo1ng/dsh-sorceress-widget#readme",
  "bugs": {
    "url": "https://github.com/cococo1ng/dsh-sorceress-widget/issues"
  }
}
